{
  "name": "teaboom-product-card",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "css": "sass src/styles/main.scss styles/main.css",
    "css:watch": "sass --watch src/styles/main.scss styles/main.css",
    "css:build": "sass src/styles/main.scss dist/styles/main.css --no-source-map",
    "clean": "rimraf dist",
    "copy": "copyfiles index.html favicon.ico \"images/**/*\" \"src/scripts/*.js\" dist",
    "dev": "npm-run-all css --parallel css:watch start",
    "start": "serve -l 4321 --no-port-switching",
    "build": "npm-run-all clean copy css:build",
    "preview": "serve dist -l 4321 --no-port-switching"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "sass": "1.93.2",
    "serve": "^14.2.4"
  }
}
